# Copy to .env and fill in. The two :?-guarded values are REQUIRED — compose
# refuses to start without them, on purpose.

# Required. Postgres password for the compose-internal database.
POSTGRES_PASSWORD=

# Required. Signs demo-session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Demo sessions expire after this. Cleanup of demo request history is
# separate (HISTORY_RETENTION_DAYS below).
DEMO_TOKEN_TTL=2h

# Ollama on the VPS, outside Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:8b

# Cloud providers — OPTIONAL. Leave empty and the router runs local-only,
# with the decision panel showing cloud candidates as "not configured".
# Setting a key here makes that provider's models real routing candidates,
# and a public unattended demo will then spend real money on them — set a
# spend cap on the provider's own dashboard before enabling one here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

MAX_PROMPT_CHARS=2000

# Demo request history older than this many days is deleted by the hourly
# in-app cron (seed rows are kept). Also runnable manually:
#   pnpm db:cleanup
HISTORY_RETENTION_DAYS=7

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=15
